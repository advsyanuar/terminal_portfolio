---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
const { Content } = await post.render();
---

<Layout title={title + " — ROOT@PORTFOLIO"} activePage="blog">
  <article class="w-full">
    <!-- Breadcrumb -->
    <div class="mb-6 flex items-center gap-2 text-code-sm">
      <a
        href="/blog"
        class="text-on-surface-variant hover:text-primary transition-colors"
        >&larr; BACK</a
      >
      <span class="text-on-surface-variant/30">/</span>
      <span class="text-on-surface-variant">~</span>
      <span class="text-on-surface-variant/30">/</span>
      <span class="text-on-surface-variant">blog</span>
      <span class="text-on-surface-variant/30">/</span>
      <span class="text-primary">{post.slug}</span>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_220px] gap-6">
      <!-- Left: main content -->
      <div
        class="bento-cell border border-[#1e3a8a] bg-[#0f172a] p-6 relative overflow-hidden min-w-0"
      >
        <span
          class="absolute top-0 right-0 bg-primary text-[#ffffff] text-[10px] px-1.5 py-0.5 font-bold"
          >BLOG_POST</span
        >
        <h1 class="font-headline-lg text-primary mb-2">{title}</h1>
        <div
          class="flex flex-wrap items-center gap-4 text-code-sm text-on-surface-variant mb-6"
        >
          <time datetime={date.toISOString()}
            >{date.toISOString().slice(0, 10)}</time
          >
          {tags.length > 0 && (
            <div class="flex gap-2">
              {tags.map((tag) => (
                <span
                  class="border border-primary/30 px-2 py-0.5 text-[10px]"
                  >{tag}</span
                >
              ))}
            </div>
          )}
        </div>
        {description && (
          <p
            class="text-body-md text-on-surface-variant mb-8 border-l-2 border-primary/30 pl-4"
          >
            {description}
          </p>
        )}

        <div class="prose-custom">
          <Content />
        </div>
      </div>

      <!-- Right: Table of Contents -->
      <aside class="hidden lg:block">
        <div
          class="sticky top-12 border border-primary/30 bg-surface-container-low p-4"
        >
          <p
            class="text-[10px] text-on-surface-variant mb-3 font-bold tracking-wider"
          >
            TABLE_OF_CONTENTS
          </p>
          <nav id="toc-nav" class="max-h-[calc(100vh-120px)] overflow-y-auto">
            <!-- Populated by JS -->
          </nav>
        </div>
      </aside>
    </div>
  </article>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const content = document.querySelector(".prose-custom");
    const tocNav = document.getElementById("toc-nav");
    if (!content || !tocNav) return;

    const headings = content.querySelectorAll("h2, h3");
    if (headings.length === 0) {
      const aside = tocNav.closest("aside");
      if (aside) aside.style.display = "none";
      return;
    }

    const list = document.createElement("ul");
    list.className = "space-y-0.5";

    const headingList = [];
    const linkMap = new WeakMap();

    headings.forEach((h) => {
      const level = h.tagName.toLowerCase();
      const text = h.textContent.trim();

      if (!h.id) {
        h.id =
          text
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/^-|-$/g, "") || "section";
      }

      const li = document.createElement("li");
      if (level === "h3") li.className = "ml-3";

      const a = document.createElement("a");
      a.href = "#" + h.id;
      a.className =
        "block text-[11px] py-1 text-on-surface-variant hover:text-primary transition-colors border-l-2 border-transparent hover:border-primary/50 pl-2";
      a.textContent = text;

      li.appendChild(a);
      list.appendChild(li);
      headingList.push(h);
      linkMap.set(h, a);
    });

    tocNav.appendChild(list);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = linkMap.get(entry.target);
          if (!link) return;

          if (entry.isIntersecting) {
            tocNav.querySelectorAll("a").forEach((a) => {
              a.classList.remove("text-primary", "border-primary");
              a.classList.add(
                "text-on-surface-variant",
                "border-transparent"
              );
            });
            link.classList.remove(
              "text-on-surface-variant",
              "border-transparent"
            );
            link.classList.add("text-primary", "border-primary");
          }
        });
      },
      { rootMargin: "-80px 0px -65% 0px", threshold: 0 }
    );

    headingList.forEach((h) => observer.observe(h));

    tocNav.addEventListener("click", (e) => {
      const link = e.target.closest("a");
      if (!link) return;
      e.preventDefault();
      const target = document.getElementById(link.getAttribute("href").slice(1));
      if (target) {
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  });
</script>

<style is:global>
  .prose-custom {
    color: #e3e2e2;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    line-height: 1.6;
  }
  .prose-custom h1,
  .prose-custom h2,
  .prose-custom h3,
  .prose-custom h4 {
    color: #3b82f6;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-custom h1 { font-size: 24px; }
  .prose-custom h2 { font-size: 20px; }
  .prose-custom h3 { font-size: 16px; }
  .prose-custom p { margin-bottom: 1rem; }
  .prose-custom a { color: #3b82f6; text-decoration: underline; }
  .prose-custom code {
    background: #1e293b;
    padding: 0.125rem 0.375rem;
    font-size: 12px;
  }
  .prose-custom pre {
    background: #050506;
    border: 1px solid #1e3a8a;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .prose-custom pre code {
    background: none;
    padding: 0;
  }
  .prose-custom ul,
  .prose-custom ol {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .prose-custom ul { list-style: none; }
  .prose-custom ul li::before {
    content: "* ";
    color: #3b82f6;
  }
  .prose-custom ol { list-style: none; counter-reset: item; }
  .prose-custom ol li { counter-increment: item; }
  .prose-custom ol li::before {
    content: counter(item, decimal-leading-zero) ". ";
    color: #3b82f6;
  }
  .prose-custom blockquote {
    border-left: 2px solid #3b82f6;
    padding-left: 1rem;
    margin-left: 0;
    color: #94a3b8;
    font-style: italic;
  }
  .prose-custom hr {
    border: none;
    border-top: 1px solid #1e293b;
    margin: 2rem 0;
  }
  .prose-custom img {
    border: 1px solid #1e293b;
    max-width: 100%;
  }
  .prose-custom table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }
  .prose-custom th,
  .prose-custom td {
    border: 1px solid #1e293b;
    padding: 0.5rem;
    text-align: left;
  }
  .prose-custom th {
    background: #1e293b;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.1em;
  }
</style>
