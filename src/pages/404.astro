---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — NOT_FOUND">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="font-headline-lg text-primary mb-4">ERROR 404</h1>
    <p class="text-body-lg text-on-surface-variant mb-8">
      FILE_NOT_FOUND: The requested resource does not exist.
    </p>
    <a
      href="/"
      class="border border-primary py-2 px-6 text-label-caps hover:bg-primary hover:text-on-primary-container transition-colors"
    >
      [ RETURN_TO_ROOT ]
    </a>
  </div>
</Layout>
