---
import Layout from "../layouts/Layout.astro";
---

<Layout title="FINGER_ABOUT — ROOT@PORTFOLIO" activePage="about">
  <div class="bento-cell w-full border border-[#1e3a8a] bg-[#0f172a] p-6 relative overflow-hidden">
    <span class="absolute top-0 right-0 bg-primary text-[#ffffff] text-[10px] px-1.5 py-0.5 font-bold">FINGER_ABOUT</span>
    <h1 class="font-headline-lg text-primary mb-8">ABOUT.TXT</h1>

    <div class="text-body-md text-on-surface-variant space-y-4">
      <p>Hi, I'm a systems-minded engineer and builder.</p>
      <p>
        I work across the stack with a focus on TypeScript, Rust, and
        infrastructure. This is my digital archive — a place for projects,
        writing, and experiments at the intersection of software and systems.
      </p>
      <p>
        When I'm not shipping code, I'm usually digging into distributed
        systems, low-level performance, or terminal aesthetics.
      </p>
    </div>

    <div class="mt-8 pt-6 border-t border-primary/20">
      <h2 class="font-headline-md text-primary mb-4">CONNECT</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://github.com/manonthemoon"
          class="border border-primary py-2 px-4 text-label-caps hover:bg-primary hover:text-on-primary-container transition-colors"
        >
          [ GITHUB ]
        </a>
      </div>
    </div>
  </div>
</Layout>
