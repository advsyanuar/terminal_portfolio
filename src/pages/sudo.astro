---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const projects = await getCollection("projects");
const stats = {
  posts: posts.length,
  drafts: posts.filter((p) => p.data.draft).length,
  projects: projects.length,
  featured: projects.filter((p) => p.data.featured).length,
};
---

<Layout
  title="SUDO — ROOT@PORTFOLIO"
  activePage="sudo"
  fullContent
  headerPostCount={stats.posts}
  headerProjectCount={stats.projects}
>
  <div id="terminal-container" class="w-full h-full"></div>
</Layout>

<script>
  import { Terminal } from "xterm";
  import { FitAddon } from "@xterm/addon-fit";
  import "xterm/css/xterm.css";

  const container = document.getElementById("terminal-container");

  const terminal = new Terminal({
    theme: {
      background: "#0a0a0c",
      foreground: "#3b82f6",
      cursor: "#3b82f6",
      cursorAccent: "#0a0a0c",
      selectionBackground: "#1e3a8a",
      selectionInactiveBackground: "#1e293b",
      black: "#0a0a0c",
      red: "#ffb4ab",
      green: "#3b82f6",
      yellow: "#ffd393",
      blue: "#3b82f6",
      magenta: "#3b82f6",
      cyan: "#3b82f6",
      white: "#e3e2e2",
      brightBlack: "#1e293b",
      brightRed: "#ffb4ab",
      brightGreen: "#3b82f6",
      brightYellow: "#ffd393",
      brightBlue: "#3b82f6",
      brightMagenta: "#3b82f6",
      brightCyan: "#3b82f6",
      brightWhite: "#ffffff",
    },
    fontFamily: '"JetBrains Mono", monospace',
    fontSize: 14,
    cursorBlink: true,
    cursorStyle: "underline",
    allowProposedApi: true,
    scrollback: 5000,
    cols: 80,
    rows: 24,
  });

  const fitAddon = new FitAddon();
  terminal.loadAddon(fitAddon);
  terminal.open(container);
  fitAddon.fit();

  window.addEventListener("resize", () => {
    fitAddon.fit();
  });

  // Boot sequence
  const bootLines = [
    { text: "[ OK ] Initializing admin kernel...", delay: 150 },
    { text: "[ OK ] Mounting virtual filesystem...", delay: 300 },
    { text: "[ OK ] Starting WASM runtime... [STUB — not connected]", delay: 500 },
    { text: "[ WARN ] Running in local mode", delay: 700 },
    { text: "", delay: 850 },
    { text: "  Welcome to Portfolio Admin v0.1.0", delay: 1050 },
    { text: "  Type 'help' for available commands.", delay: 1200 },
  ];

  let bootIndex = 0;
  function writeBoot() {
    if (bootIndex < bootLines.length) {
      terminal.writeln(bootLines[bootIndex].text);
      bootIndex++;
      setTimeout(writeBoot, bootLines[bootIndex - 1].delay);
    } else {
      writePrompt();
      terminal.focus();
    }
  }

  let bootTimeout = setTimeout(writeBoot, 100);

  // Command processor
  let inputBuffer = "";
  let commandHistory = [];
  let historyIndex = -1;
  let isProcessing = false;

  /*
   * ─── WASM Integration Point ──────────────────────────────────
   *
   * When the Rust Ratatui WASM module is ready, replace the local
   * command processor with WASM-backed stdin/stdout:
   *
   *   1. terminal.onData() → pipe bytes to WASM stdin
   *   2. WASM stdout callback → terminal.write()
   *   3. Remove the local handleCommand / inputBuffer logic
   *
   * The FitAddon stays for terminal resizing.
   * Example:
   *
   *   const wasm = await WebAssembly.instantiate(module, {
   *     env: { putchar: (c) => terminal.write(String.fromCharCode(c)) }
   *   });
   *   terminal.onData((data) => wasm.instance.exports.stdin(data.charCodeAt(0)));
   *
   * ──────────────────────────────────────────────────────────────
   */

  function writePrompt() {
    terminal.write("\r\nadmin@portfolio:~$ ");
  }

  function processCommand(cmd) {
    const lowered = cmd.toLowerCase().trim();

    if (lowered === "") return;

    if (lowered === "help") {
      terminal.writeln("Available commands:");
      terminal.writeln("  stats       — show site statistics");
      terminal.writeln("  clear       — clear terminal");
      terminal.writeln("  reboot      — replay boot sequence");
      terminal.writeln("  exit        — return to homepage");
      terminal.writeln("  whoami      — show user");
      terminal.writeln("  date        — show date/time");
      terminal.writeln("  btw         — system info");
      terminal.writeln("  help        — show this message");
      return;
    }

    if (lowered === "stats") {
      terminal.writeln(`posts:     ${stats.posts} (${stats.drafts} drafts)`);
      terminal.writeln(`projects:  ${stats.projects} (${stats.featured} featured)`);
      return;
    }

    if (lowered === "clear") {
      terminal.clear();
      return;
    }

    if (lowered === "reboot") {
      terminal.clear();
      bootIndex = 0;
      isProcessing = true;
      writeBoot();
      return;
    }

    if (lowered === "exit") {
      terminal.writeln("Logging out...");
      setTimeout(() => {
        window.location.href = "/";
      }, 500);
      return;
    }

    if (lowered === "whoami") {
      terminal.writeln("admin@portfolio");
      return;
    }

    if (lowered === "date") {
      terminal.writeln(new Date().toString());
      return;
    }

    if (lowered === "btw") {
      const uptime = Math.floor((Date.now() - performance.now()) / 1000);
      terminal.writeln("       _.---.._           admin@portfolio");
      terminal.writeln("    .'        '.         -----------------");
      terminal.writeln("   /   TERMINAL  \\        OS: Static HTML");
      terminal.writeln("  /    PORTFOLIO  \\      Shell: bash v5.2");
      terminal.writeln(" /________________\\     Uptime: " + uptime + "s");
      return;
    }

    terminal.writeln(`bash: ${cmd.trim().split(/\s+/)[0]}: command not found`);
  }

  terminal.onData((data) => {
    if (bootIndex < bootLines.length) return;

    const code = data.charCodeAt(0);

    if (code === 13) {
      // Enter
      terminal.write("\r\n");
      const cmd = inputBuffer;
      if (cmd.trim()) {
        commandHistory.push(cmd.trim());
        historyIndex = commandHistory.length;
      }
      processCommand(cmd);
      inputBuffer = "";
      writePrompt();
    } else if (code === 127) {
      // Backspace
      if (inputBuffer.length > 0) {
        inputBuffer = inputBuffer.slice(0, -1);
        terminal.write("\b \b");
      }
    } else if (code === 3) {
      // Ctrl+C
      terminal.write("^C\r\n");
      inputBuffer = "";
      writePrompt();
    } else if (code === 27 && data.length >= 3) {
      // Arrow keys (ESC sequences)
      if (data === "\x1b[A") {
        // Up
        if (commandHistory.length > 0) {
          if (historyIndex > 0) historyIndex--;
          const prev = commandHistory[historyIndex];
          // Clear current line
          while (inputBuffer.length > 0) {
            terminal.write("\b \b");
            inputBuffer = inputBuffer.slice(0, -1);
          }
          inputBuffer = prev;
          terminal.write(prev);
        }
      } else if (data === "\x1b[B") {
        // Down
        if (historyIndex < commandHistory.length - 1) {
          historyIndex++;
          while (inputBuffer.length > 0) {
            terminal.write("\b \b");
            inputBuffer = inputBuffer.slice(0, -1);
          }
          const next = commandHistory[historyIndex];
          inputBuffer = next;
          terminal.write(next);
        } else {
          historyIndex = commandHistory.length;
          while (inputBuffer.length > 0) {
            terminal.write("\b \b");
            inputBuffer = inputBuffer.slice(0, -1);
          }
        }
      }
    } else if (data.length === 1 && code >= 32 && code <= 126) {
      // Printable character
      inputBuffer += data;
      terminal.write(data);
    }
  });
</script>
