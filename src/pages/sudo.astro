---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const projects = await getCollection("projects");
const stats = {
  posts: posts.length,
  drafts: posts.filter((p) => p.data.draft).length,
  projects: projects.length,
  featured: projects.filter((p) => p.data.featured).length,
};

const entryData = JSON.stringify({
  blog: posts.map((p) => ({
    slug: p.id,
    title: p.data.title,
    date: p.data.date instanceof Date
      ? p.data.date.toISOString().slice(0, 10)
      : String(p.data.date).slice(0, 10),
    description: p.data.description,
  })),
  projects: projects.map((p) => ({
    slug: p.id,
    title: p.data.title,
    date: p.data.date instanceof Date
      ? p.data.date.toISOString().slice(0, 10)
      : String(p.data.date).slice(0, 10),
    description: p.data.description,
  })),
});
---

<Layout
  title="SUDO — ROOT@PORTFOLIO"
  activePage="sudo"
  fullContent
  headerPostCount={stats.posts}
  headerProjectCount={stats.projects}
>
  <div id="terminal-container" class="w-full h-full" data-entries={entryData}></div>
</Layout>

<script>
  import { Terminal } from "xterm";
  import { FitAddon } from "@xterm/addon-fit";
  import "xterm/css/xterm.css";

  const container = document.getElementById("terminal-container");

  const terminal = new Terminal({
    theme: {
      background: "#0a0a0c",
      foreground: "#3b82f6",
      cursor: "#3b82f6",
      cursorAccent: "#0a0a0c",
      selectionBackground: "#1e3a8a",
      selectionInactiveBackground: "#1e293b",
      black: "#0a0a0c",
      red: "#ffb4ab",
      green: "#3b82f6",
      yellow: "#ffd393",
      blue: "#3b82f6",
      magenta: "#3b82f6",
      cyan: "#3b82f6",
      white: "#e3e2e2",
      brightBlack: "#1e293b",
      brightRed: "#ffb4ab",
      brightGreen: "#3b82f6",
      brightYellow: "#ffd393",
      brightBlue: "#3b82f6",
      brightMagenta: "#3b82f6",
      brightCyan: "#3b82f6",
      brightWhite: "#ffffff",
    },
    fontFamily: '"JetBrains Mono", monospace',
    fontSize: 14,
    cursorBlink: true,
    cursorStyle: "underline",
    allowProposedApi: true,
    scrollback: 5000,
    cols: 80,
    rows: 24,
  });

  const fitAddon = new FitAddon();
  terminal.loadAddon(fitAddon);
  terminal.open(container);
  fitAddon.fit();

  // Boot sequence
  const bootLines = [
    { text: "[ OK ] Initializing admin kernel...", delay: 150 },
    { text: "[ OK ] Mounting virtual filesystem...", delay: 300 },
  ];

  let bootIndex = 0;
  let rafId = null;
  let wasm = null;

  function writeBoot() {
    if (bootIndex < bootLines.length) {
      terminal.writeln(bootLines[bootIndex].text);
      bootIndex++;
      setTimeout(writeBoot, bootLines[bootIndex - 1].delay);
    } else {
      terminal.write("[ .... ] Loading WASM runtime...");
      initWasm();
    }
  }

  async function initWasm() {
    try {
      const params = new URLSearchParams(window.location.search);
      const baseUrl = params.get("api") || window.location.origin;

      const mod = await import("../admin/editor.js");
      await mod.default();

      mod.init(baseUrl, terminal.cols, terminal.rows);
      const entryData = container?.dataset?.entries;
      if (entryData) mod.load_entries(entryData);

      wasm = mod;

      terminal.write("\r[ OK ] WASM runtime loaded\n");
      terminal.focus();

      rafId = requestAnimationFrame(function frame() {
        try {
          const output = wasm.tick();
          if (output) terminal.write(output);
        } catch (err) {
          terminal.write(`\r\n\x1b[31m[WASM ERROR]\x1b[0m ${err.message}\n`);
          return;
        }
        rafId = requestAnimationFrame(frame);
      });
    } catch (err) {
      terminal.write(`\r[FAIL] ${err.message}\n`);
    }
  }

  terminal.onData((data) => {
    if (!wasm) return;

    if (data === "\x1b[Z") { wasm.push_backtab(); return; }
    if (data === "\x13")   { wasm.push_ctrl_s(); return; }

    wasm.push_key(data);
  });

  window.addEventListener("resize", () => {
    fitAddon.fit();
    if (wasm) wasm.resize(terminal.cols, terminal.rows);
  });

  setTimeout(writeBoot, 100);
</script>
