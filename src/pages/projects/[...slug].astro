---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, date, techStack, links } = project.data;
const { Content } = await project.render();
---

<Layout title={title + " — ROOT@PORTFOLIO"} activePage="projects">
  <article class="w-full">
    <div class="mb-8">
      <a href="/projects" class="text-code-sm text-on-surface-variant hover:text-primary">&larr; BACK TO PROJECTS</a>
    </div>

    <div class="bento-cell border border-[#1e3a8a] bg-[#0f172a] p-6 relative overflow-hidden">
      <span class="absolute top-0 right-0 bg-primary text-[#ffffff] text-[10px] px-1.5 py-0.5 font-bold">PROJECT_DETAIL</span>
      <h1 class="font-headline-lg text-primary mb-2">{title}</h1>

      <div class="flex flex-wrap items-center gap-4 text-code-sm text-on-surface-variant mb-6">
        <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
        {techStack.length > 0 && techStack.map((tech) => (
          <span class="border border-primary/30 px-2 py-0.5 text-[10px]">{tech}</span>
        ))}
      </div>

      <p class="text-body-md text-on-surface-variant mb-8">{description}</p>

      <div class="flex gap-4 mb-8">
        {links.source && (
          <a href={links.source} class="border border-primary py-2 px-4 text-label-caps hover:bg-primary hover:text-on-primary-container transition-colors">
            [ SOURCE ]
          </a>
        )}
        {links.demo && (
          <a href={links.demo} class="border border-primary py-2 px-4 text-label-caps hover:bg-primary hover:text-on-primary-container transition-colors">
            [ DEMO ]
          </a>
        )}
      </div>

      <div class="prose-custom">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .prose-custom {
    color: #e3e2e2;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    line-height: 1.6;
  }
  .prose-custom h1,
  .prose-custom h2,
  .prose-custom h3,
  .prose-custom h4 {
    color: #3b82f6;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-custom h1 { font-size: 24px; }
  .prose-custom h2 { font-size: 20px; }
  .prose-custom h3 { font-size: 16px; }
  .prose-custom p { margin-bottom: 1rem; }
  .prose-custom a { color: #3b82f6; text-decoration: underline; }
  .prose-custom code {
    background: #1e293b;
    padding: 0.125rem 0.375rem;
    font-size: 12px;
  }
  .prose-custom pre {
    background: #050506;
    border: 1px solid #1e3a8a;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .prose-custom pre code {
    background: none;
    padding: 0;
  }
</style>
